# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:your-bot-token-here
# Your Telegram user id (message @userinfobot to find it)
ADMIN_TELEGRAM_ID=123456789
# SQLite file path. On Railway, mount a volume at /data and set this to /data/orders.db
DATABASE_PATH=./data/orders.db
# Optional: HTTP port (Railway injects PORT automatically)
PORT=3000
# Optional scraper tuning
SCRAPER_TIMEOUT_MS=30000
SCRAPER_NAV_DELAY_MS=1500
# Admin web panel password (open http://localhost:3000/admin and enter it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PANEL_TOKEN=change-me-to-a-long-random-string
# Scraper provider: "oxylabs" | "playwright" | unset = auto (Oxylabs if creds present)
SCRAPER_PROVIDER=oxylabs
# Oxylabs Realtime API credentials (https://dashboard.oxylabs.io) — paid provider
OXYLABS_USERNAME=your-oxylabs-username
OXYLABS_PASSWORD=your-oxylabs-password
# Max wait for one Oxylabs realtime query (1688 pages are heavy; 60-180s normal)
OXYLABS_TIMEOUT_MS=180000
# Pricing defaults (live values are stored in SQLite via panel/commands and win):
# DZD per 1 USD (default 255, admin-editable)
USD_RATE_DZD=255
# Freight estimate per kg in DZD (default 5000, admin-editable)
FREIGHT_PER_KG_DZD=5000
